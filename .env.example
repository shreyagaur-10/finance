# ══════════════════════════════════════════════════════════════════════════════
# Multi-Agent Financial AI Planner — Environment Variables
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Groq API (Primary LLM) ────────────────────────────────────────────────────
# Sign up free at: https://console.groq.com
# Free tier: 30 req/min, 14,400 req/day on Llama 3.3 70B
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Gemini (Fallback LLM) ──────────────────────────────────────────────
# Get free API key at: https://aistudio.google.com/app/apikey
# Free tier: 15 req/min, 1M tokens/day on Gemini Flash
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-1.5-flash

# ── Supabase (Postgres Database) ──────────────────────────────────────────────
# Sign up free at: https://supabase.com
# Free tier: 500MB database, 5GB bandwidth
# After creating project: Settings > API > URL and keys
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...your_service_role_key_here
# Get connection string: Settings > Database > Connection string (Transaction pooler)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Upstash Redis (Task Queue) ────────────────────────────────────────────────
# Sign up free at: https://upstash.com
# Free tier: 10,000 commands/day, 256MB
# After creating Redis database: copy REST URL and token
UPSTASH_REDIS_URL=https://xxxxxxxxxxxx.upstash.io
UPSTASH_REDIS_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Langfuse (Observability) ──────────────────────────────────────────────────
# Sign up free at: https://cloud.langfuse.com
# Or self-host via Docker (see docker/docker-compose.yml)
# Free cloud tier: unlimited traces, 30-day retention
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=Financial AI Planner
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501
MAX_REQUESTS_PER_MINUTE=10
LOG_LEVEL=INFO
